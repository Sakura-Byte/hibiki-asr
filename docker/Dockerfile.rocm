# syntax=docker/dockerfile:1
#
# AMD ROCm on Linux. EXPERIMENTAL: GPU inference is NOT VERIFIED on AMD hardware.
# Uses the official, SHA256-checked CTranslate2 ROCm archive pinned in provision/variants.toml.
# The base image supplies ROCm userspace; the host still needs the AMD driver and GPU device access:
#   docker build -f docker/Dockerfile.rocm -t hibiki-asr:rocm .
#   docker run --rm --device=/dev/kfd --device=/dev/dri --group-add video --group-add render \
#     --security-opt seccomp=unconfined -e HIBIKI_ASR_TOKEN=change-me -p 8001:8001 \
#     -v hibiki-asr-data:/data hibiki-asr:rocm

ARG ROCM_IMAGE=rocm/dev-ubuntu-22.04:7.2.4
# hadolint ignore=DL3006
FROM ${ROCM_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# Build arguments must not use the reserved HIBIKI_ASR_* settings prefix.
ARG SETUP_ARGS=

# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates hiprand hipblas rocrand \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 hibiki \
 && useradd --create-home --uid 10001 --gid 10001 --shell /usr/sbin/nologin hibiki \
 && mkdir /data \
 && chown 10001:10001 /data

ENV PATH="/opt/venv/bin:${PATH}"
WORKDIR /src
COPY pyproject.toml README.md ./
COPY src ./src
COPY LICENSE NOTICE /usr/share/doc/hibiki-asr/

# hadolint ignore=SC2086
RUN python3 -m venv /opt/venv \
 && pip install --no-cache-dir uv==0.13.7 \
 && uv pip install --python /opt/venv/bin/python ".[runtime]" \
 && HIBIKI_ASR_DATA_DIR=/tmp/setup-state hibiki-asr setup --variant rocm-linux --yes --allow-experimental ${SETUP_ARGS}

ENV HIBIKI_ASR_VARIANT=rocm-linux \
    HIBIKI_ASR_DATA_DIR=/data \
    HIBIKI_ASR_HOST=0.0.0.0 \
    PYTHONUNBUFFERED=1
USER 10001:10001
VOLUME /data
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/v1/healthz' % os.environ.get('HIBIKI_ASR_PORT', '8001'), timeout=4)"]
ENTRYPOINT ["hibiki-asr"]
CMD ["serve"]
